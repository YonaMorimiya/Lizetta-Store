# ───────── Database (Vercel Postgres / Neon) ─────────
# Pooled connection (runtime)
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"
# Direct connection (migrations) — optional, Vercel Postgres sets POSTGRES_URL_NON_POOLING
DIRECT_URL="postgres://user:pass@host/db?sslmode=require"

# ───────── NextAuth ─────────
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ───────── Admin seed ─────────
ADMIN_EMAIL="admin@lizetta.local"
ADMIN_PASSWORD="change-me-on-first-login"

# ───────── QRIS / Orderkuota ─────────
# Your QRIS static string (scan from your Orderkuota static QR image) — required for generating dynamic QR
QRIS_STATIC_STRING=""
# Orderkuota API (used to poll mutasi for payment confirmation)
ORDERKUOTA_MERCHANT_ID=""
ORDERKUOTA_API_KEY=""

# ───────── TempMail (mail.tm) ─────────
# No API key needed; mail.tm is public. This is just a cache namespace.
MAILTM_DOMAIN_CACHE_MINUTES=60

# ───────── Bootstrap endpoint ─────────
# Secret key for /api/bootstrap — hit once after deploy to seed admin + sample products.
# Example: openssl rand -hex 16
BOOTSTRAP_KEY=""
